@inject IJSRuntime Js

@* keel's code surface, ported from the CodeBlock control on the Meridian page.

   One control, two chromes. Console shows a title beside the prompt, for
   commands; Editor shows tabs and the language, for payloads and files. Both
   open with the fixed `>_` lead cell, which is what keeps the first tab off
   the rounded corner. Colour comes from the block-level --cb-* variables in
   keel.css, so `keel-cb--auto` re-skins the whole surface, chrome and syntax,
   with the page theme. *@

<div class="keel-cb keel-cb--auto">
    <div class="@(Chrome == CodeChrome.Editor && HasTabs ? "keel-cb__tabs" : "keel-cb__bar")">
        <span class="keel-cb__lead" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m4 17 6-6-6-6" />
                <path d="M12 19h8" />
            </svg>
        </span>

        @if (Chrome == CodeChrome.Editor && HasTabs)
        {
            @foreach (var tab in Items)
            {
                var active = tab.Label == Active.Label;
                <button type="button" class="keel-cb__tab @(active ? "keel-cb__tab--active" : "")"
                        aria-selected="@(active ? "true" : "false")" @onclick="() => Select(tab)">
                    @if (active && tab.Language.Dot() is { } dot)
                    {
                        <span class="keel-cb__dot" style="background:@dot"></span>
                    }
                    @tab.Label
                </button>
            }
        }
        else
        {
            <span class="keel-cb__title">@Active.Label</span>
        }

        @if (ShowLanguage)
        {
            <span class="keel-cb__lang">@Active.Language.Label()</span>
        }

        <button type="button" class="keel-cb__action @(ShowLanguage ? "keel-cb__action--tight" : "")"
                @onclick="CopyAsync"
                aria-label="@(_copied ? "Copied" : "Copy")" title="@(_copied ? "Copied" : "Copy")">
            @if (_copied)
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                </svg>
            }
            else
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="11" height="11" rx="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                </svg>
            }
        </button>
    </div>

    <div class="keel-cb__scroll">
        <pre class="keel-cb__pre"><code>@((MarkupString)Highlighted)</code></pre>
    </div>
</div>

@code {
    /// <summary>One pane of the surface: a tab in editor chrome, the whole body otherwise.</summary>
    public sealed record Tab(string Label, string Code, CodeLanguage Language);

    /// <summary>Editor chrome (tabs) or console chrome (a title beside the prompt).</summary>
    [Parameter] public CodeChrome Chrome { get; set; } = CodeChrome.Editor;

    /// <summary>Panes, for editor chrome. Ignored when <see cref="Code"/> is set.</summary>
    [Parameter] public IReadOnlyList<Tab> Tabs { get; set; } = Array.Empty<Tab>();

    /// <summary>A single body, the usual way to use console chrome.</summary>
    [Parameter] public string? Code { get; set; }

    /// <summary>Title for a single body, e.g. the command being shown.</summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>Language of a single body.</summary>
    [Parameter] public CodeLanguage Language { get; set; } = CodeLanguage.PlainText;

    /// <summary>Show the language label at the right of the chrome.</summary>
    [Parameter] public bool ShowLanguage { get; set; }

    private Tab? _selected;
    private bool _copied;

    private IReadOnlyList<Tab> Items =>
        Code is not null ? new[] { new Tab(Title, Code, Language) } : Tabs;

    private bool HasTabs => Items.Count > 1;

    private Tab Active =>
        (_selected is not null ? Items.FirstOrDefault(t => t.Label == _selected.Label) : null)
        ?? Items.FirstOrDefault()
        ?? new Tab("", "", CodeLanguage.PlainText);

    private string Highlighted => Highlighter.Highlight(Active.Code, Active.Language);

    protected override void OnParametersSet()
    {
        if (_selected is not null && Items.All(t => t.Label != _selected.Label)) _selected = null;
    }

    private void Select(Tab tab)
    {
        _selected = tab;
        _copied = false;
    }

    private async Task CopyAsync()
    {
        try { await Js.InvokeVoidAsync("ppapi.copy", Active.Code); } catch { /* clipboard unavailable */ }
        _copied = true;
        StateHasChanged();
    }
}
