@* The landing page for a spec: what it is, where it came from, and the shape
   of its surface. *@

<div class="page">
    <h1 class="page__title">@Spec.Info.Title</h1>

    @if (Spec.Info.Version is { } v)
    {
        <div class="keel-badge" style="margin-bottom:var(--s-4)">
            <span class="keel-badge__dot"></span> @v
        </div>
    }

    @if (Spec.Info.Description is { } d)
    {
        <p class="page__lead">@d</p>
    }

    <div class="op-body">
        <div class="op-split">
            <div>
                <section class="section">
                    <h2 class="section__title">Resources</h2>
                    @foreach (var tag in Tags)
                    {
                        <div class="prop">
                            <div class="prop__head">
                                <span class="prop__name">@tag.Tag.Name</span>
                                <span class="prop__type">@tag.Count operation@(tag.Count == 1 ? "" : "s")</span>
                            </div>
                            @if (tag.Tag.Description is { } td)
                            {
                                <p class="prop__desc">@td</p>
                            }
                        </div>
                    }
                </section>
            </div>

            <aside class="op-split__aside">
                <div class="keel-card keel-card--outlined" style="padding:var(--s-4)">
                    <h2 class="section__title">At a glance</h2>
                    <div class="prop">
                        <div class="prop__head">
                            <span class="prop__name">@Spec.Operations.Count</span>
                            <span class="prop__type">operations</span>
                        </div>
                    </div>
                    <div class="prop">
                        <div class="prop__head">
                            <span class="prop__name">@Tags.Count</span>
                            <span class="prop__type">resources</span>
                        </div>
                    </div>
                    <div class="prop">
                        <div class="prop__head">
                            <span class="prop__name">@Spec.Schemas.Count</span>
                            <span class="prop__type">schemas</span>
                        </div>
                    </div>
                    @if (Spec.Servers.FirstOrDefault() is { } server)
                    {
                        <div class="prop">
                            <div class="prop__head">
                                <span class="prop__type">@server</span>
                            </div>
                        </div>
                    }
                </div>
            </aside>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public OpenApiSpec Spec { get; set; } = default!;
    [Parameter] public SpecEntry? Entry { get; set; }
    [Parameter] public EventCallback<Route> OnNavigate { get; set; }

    private sealed record TagCount(SpecTag Tag, int Count);

    private List<TagCount> Tags
    {
        get
        {
            var counts = Spec.Operations
                .GroupBy(o => o.PrimaryTag, StringComparer.Ordinal)
                .ToDictionary(g => g.Key, g => g.Count(), StringComparer.Ordinal);

            return Spec.TagsInOrder()
                .Where(t => counts.ContainsKey(t.Name))
                .Select(t => new TagCount(t, counts[t.Name]))
                .ToList();
        }
    }
}
