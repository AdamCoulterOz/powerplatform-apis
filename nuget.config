<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- keel lives in a private repo, so restoring it needs a token with
         read:packages. In CI, GITHUB_TOKEN already has it. -->
    <add key="keel" value="https://nuget.pkg.github.com/AdamCoulterOz/index.json" />
  </packageSources>
</configuration>
