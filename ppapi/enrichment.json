 "schemas": {
  "Value": {
   "rename": "RoleDefinition",
   "notes": [
    "The docs define one Value model reused for both the role-definition list and the role-assignment list. Verified live, role-assignment items are different and richer (roleAssignmentId, scope, principal fields, createdBy fields, createdOn, expiresOn); this shape reflects the role-definition list, not assignments."
   ]
  }
 },
 "addSchemas": {
  "BapLifecycleOperation": {
   "type": "object",
   "description": "A Business Application Platform lifecycle operation, returned when polling the Location handed back by an async environment-group membership change. Not documented; shape verified against the live API.",
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "links": {
     "type": "object",
     "properties": {
      "self": {
       "type": "object",
       "properties": {
        "path": {
         "type": "string"
        }
       }
      },
      "environment": {
       "type": "object",
       "properties": {
        "path": {
         "type": "string"
        }
       }
      }
     }
    },
    "type": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string",
       "description": "Operation type, for example Edit."
      }
     }
    },
    "typeDisplayName": {
     "type": "string"
    },
    "state": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string",
       "enum": [
        "NotStarted",
        "Succeeded",
        "Failed"
       ],
       "x-ms-enum": {
        "name": "LifecycleOperationState",
        "modelAsString": true
       },
       "description": "Lifecycle status. NotStarted, Succeeded and Failed were verified against the live API; the API also returns in-progress states that were not observed, so treat the set as open."
      }
     }
    },
    "createdDateTime": {
     "type": "string",
     "format": "date-time"
    },
    "lastActionDateTime": {
     "type": "string",
     "format": "date-time"
    },
    "requestedBy": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string",
       "format": "uuid"
      },
      "type": {
       "type": "string"
      }
     }
    },
    "stages": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "enum": [
         "Validate",
         "Prepare",
         "Run",
         "Finalize"
        ],
        "description": "Lifecycle stage."
       },
       "name": {
        "type": "string",
        "enum": [
         "Validate",
         "Prepare",
         "Run",
         "Finalize"
        ],
        "description": "Lifecycle stage."
       },
       "state": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "enum": [
           "NotStarted",
           "Succeeded",
           "Failed"
          ],
          "x-ms-enum": {
           "name": "LifecycleOperationState",
           "modelAsString": true
          },
          "description": "Lifecycle status. NotStarted, Succeeded and Failed were verified against the live API; the API also returns in-progress states that were not observed, so treat the set as open."
         }
        }
       },
       "firstActionDateTime": {
        "type": "string",
        "format": "date-time"
       },
       "lastActionDateTime": {
        "type": "string",
        "format": "date-time"
       }
      }
     }
    }
   }
  },
  "RbacRoleAssignment": {
   "type": "object",
   "description": "A role assignment as returned by the authorization endpoints. Shape verified against the live API; the documentation models the item as a role definition instead.",
   "properties": {
    "@odata.context": {
     "type": "string"
    },
    "roleAssignmentId": {
     "type": "string",
     "format": "uuid"
    },
    "scope": {
     "type": "string",
     "description": "Hierarchical scope, for example /tenants/{tenantId} or /tenants/{tenantId}/environments/{environmentId}."
    },
    "principalType": {
     "type": "string",
     "enum": [
      "User",
      "Group",
      "ApplicationUser"
     ],
     "description": "User, Group, or ApplicationUser."
    },
    "principalObjectId": {
     "type": "string",
     "format": "uuid"
    },
    "roleDefinitionId": {
     "type": "string",
     "format": "uuid"
    },
    "createdByPrincipalType": {
     "type": "string",
     "enum": [
      "User",
      "Group",
      "ApplicationUser"
     ],
     "description": "The kind of principal."
    },
    "createdByPrincipalObjectId": {
     "type": "string",
     "format": "uuid"
    },
    "createdOn": {
     "type": "string",
     "format": "date-time"
    },
    "expiresOn": {
     "type": "string",
     "format": "date-time",
     "nullable": true
    }
   }
  },
  "RbacRoleAssignmentList": {
   "type": "object",
   "description": "An OData collection of role assignments. Verified against the live API.",
   "properties": {
    "@odata.context": {
     "type": "string"
    },
    "value": {
     "type": "array",
     "items": {
      "$ref": "#/components/schemas/RbacRoleAssignment"
     }
    }
   }
  }
 }
