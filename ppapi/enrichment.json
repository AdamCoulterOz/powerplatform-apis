  "authorization/role-based-access-control/create-environment-group-role-assignment": {
   "summary": "Assignment Create (Environment Group)"
  },
  "authorization/role-based-access-control/create-environment-role-assignment": {
   "summary": "Assignment Create (Environment)",
   "notes": [
    "Verified live (2026-08-27): returns 200 OK, not the documented 201, and a single assignment object {roleAssignmentId, scope, principalType, principalObjectId, roleDefinitionId, createdByPrincipalType, createdByPrincipalObjectId, createdOn, expiresOn}, not the documented RoleAssignmentResponse {value:[...]} envelope.",
    "The body scope must match this path (/tenants/{tid}/environments/{id}) or the call returns 400 WrongResourceTypeForUrlContext."
   ],
   "responses": {
    "200": {
     "schema": {
      "$ref": "RbacRoleAssignment"
     },
     "description": "The created role assignment. Verified live; the documentation shows 201 with a different envelope."
    }
   }
  },
  "authorization/role-based-access-control/create-role-assignment": {
   "summary": "Assignment Create (Tenant)",
   "notes": [
    "Verified live (2026-08-27): the URL path fixes the allowed scope. Posting a body scope of /tenants/{tid}/environments/{id} to this tenant endpoint returns 400 WrongResourceTypeForUrlContext. Tenant, environment, and environment-group scoped assignments are separate endpoints, not one endpoint switched by the body scope."
   ]
  },
  "authorization/role-based-access-control/delete-environment-group-role-assignment": {
   "summary": "Assignment Delete (Environment Group)"
  },
  "authorization/role-based-access-control/delete-environment-role-assignment": {
   "summary": "Assignment Delete (Environment)",
   "notes": [
    "Verified live (2026-08-27): returns 200 with the deleted assignment in the body. Deletes are path-scoped, so an environment-scoped assignment cannot be deleted through the tenant path (that returns 404 RoleAssignmentNotFound)."
   ]
  },
  "authorization/role-based-access-control/delete-role-assignment": {
   "summary": "Assignment Delete (Tenant)"
  },
  "authorization/role-based-access-control/list-environment-group-role-assignments": {
   "summary": "Assignments List (Environment Group)"
  },
  "authorization/role-based-access-control/list-environment-role-assignments": {
   "summary": "Assignments List (Environment)",
   "notes": [
    "Verified live (2026-08-27): items carry the full assignment shape (roleAssignmentId, scope, principalType, principalObjectId, roleDefinitionId, createdBy fields, createdOn, expiresOn), not the documented role-definition-shaped item."
   ],
   "responses": {
    "200": {
     "schema": {
      "$ref": "RbacRoleAssignmentList"
     },
     "description": "Role assignments at environment scope. Verified against the live API."
    }
   }
  },
  "authorization/role-based-access-control/list-role-assignments": {
   "summary": "Assignments List (Tenant)",
   "notes": [
    "Verified live (2026-08-27): assignment items are {roleAssignmentId, scope, principalType, principalObjectId, roleDefinitionId, createdByPrincipalType, createdByPrincipalObjectId, createdOn, expiresOn}, not the documented role-definition-shaped item. The tenant list returns only tenant-scoped assignments; environment-scoped ones appear only under /authorization/environments/{id}/roleAssignments."
   ],
   "responses": {
    "200": {
     "schema": {
      "$ref": "RbacRoleAssignmentList"
     },
     "description": "Tenant-scoped role assignments. Verified against the live API."
    }
   }
  },
  "authorization/role-based-access-control/list-role-definitions": {
   "summary": "Role Definitions List",
   "notes": [
    "Verified live (2026-08-27): role definitions also carry description, roleType, assignableScopes[], restrictedScopes[], and permissionsExceptions[] beyond the documented permissions, roleDefinitionId, and roleDefinitionName."
   ]
  },
